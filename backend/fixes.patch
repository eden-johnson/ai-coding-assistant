+def reset_collection(repo_id: str) -> None:
+    """
+    Deletes the repo's collection if it exists, so re-indexing starts clean.
+    Prevents duplicate-ID collisions and stale chunks from deleted/changed files.
+    """
+    try:
+        client.delete_collection(name=repo_id)
+    except Exception:
+        # Collection didn't exist yet (first index) - nothing to delete.
+        pass
